.git
.github
.idea
.npmrc
docs/**
screenshots/**
dist/**
scripts/**

# The gateway image needs manifests for every lockfile workspace, not app source.
apps/mobile/**
!apps/mobile/package.json
apps/desktop/**
!apps/desktop/package.json
packages/aidb-mcp/**
!packages/aidb-mcp/package.json

# Source is rebuilt inside the image; tests and host artifacts are not runtime inputs.
**/node_modules/**
**/dist/**
**/build/**
**/.gradle/**
**/.expo/**
**/coverage/**
apps/gateway/test/**
apps/gateway/dist/**
packages/*/test/**
packages/*/dist/**
**/*.tsbuildinfo
**/*.log

# Never place local credentials or signing material in the build context.
**/.env
**/.env.*
**/*.keystore
**/*.jks
**/*.p12
**/*.pfx
**/*.pem
**/*.mobileprovision
**/*.provisionprofile
**/credentials.json
**/local.properties
**/.xcode.env.local
**/google-services.json
**/GoogleService-Info.plist
**/secrets/**
**/certs/**

# Native and store outputs are generated by the native toolchains, not copied into the image.
**/Pods/**
**/*.xcarchive/**
**/*.ipa
**/*.aab
**/*.apk
**/.DS_Store
