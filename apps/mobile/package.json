{
  "name": "@aidb/mobile",
  "version": "0.0.10",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8081",
    "export:web": "expo export --platform web",
    "build:android:debug": "node scripts/native-build.mjs android-debug",
    "build:android:release": "node scripts/native-build.mjs android-release",
    "build:ios:simulator": "node scripts/native-build.mjs ios-simulator",
    "build:ios:archive": "node scripts/native-build.mjs ios-archive",
    "check:release": "node scripts/check-release-config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aidb/client": "*",
    "@aidb/core": "*",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.0",
    "expo-camera": "~58.0.14",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.80.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-zeroconf": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.1",
    "typescript": "~6.0.3"
  }
}
