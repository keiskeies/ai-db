{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.3"
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "withoutCredentials": true,
      "android": {
        "gradleCommand": ":app:assembleDebug"
      },
      "ios": {
        "scheme": "AiDBStudio",
        "buildConfiguration": "Debug",
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "scheme": "AiDBStudio",
        "buildConfiguration": "Release",
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "credentialsSource": "remote",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "scheme": "AiDBStudio",
        "buildConfiguration": "Release",
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
