{
  "expo": {
    "name": "AiDB Studio",
    "slug": "aidb-studio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "aidb",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.aidb.studio",
      "permissions": [
        "INTERNET",
        "CHANGE_WIFI_MULTICAST_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.aidb.studio",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "AiDB Studio 需要访问局域网以发现并连接 Bridge。",
        "NSBonjourServices": [
          "_aidb._tcp"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 AiDB Studio 扫描桌面端配对二维码"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
