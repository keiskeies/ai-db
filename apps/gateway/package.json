    "cors": "^2.8.5",
    "dmdb": "^1.0.52452",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.13",
    "mysql2": "^3.12.0",
    "neo4j-driver": "^6.2.0",
    "oracledb": "^26.0.0",
    "pg": "^8.13.1",
    "ssh2": "^1.16.0",
    "ws": "^8.18.0"
