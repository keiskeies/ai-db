  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.5",
    "@types/oracledb": "^26.0.0",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.1",
