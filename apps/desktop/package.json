{
  "name": "@aidb/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "dev:electron": "wait-on tcp:5180 http-get://127.0.0.1:8787/api/health && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 node ../../scripts/run-electron.mjs",
    "build": "vite build",
    "package": "npm run build && electron-builder",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aidb/core": "*",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "description": "AI-native cross-platform database studio with an autonomous agent",
  "author": "AiDB"
}
